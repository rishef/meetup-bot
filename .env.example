# Required: bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: a server ID to sync slash commands to instantly while testing
# (global sync can take a few minutes to show up)
DEV_GUILD_ID=

# Optional: identify your bot to OpenStreetMap's geocoder (their usage policy asks for this)
NOMINATIM_USER_AGENT=discord-meetup-midpoint-bot/1.0 (contact: you@example.com)

# Optional: restrict address lookups to countries, comma-separated ISO codes, e.g. in,sg
NOMINATIM_COUNTRY_CODES=

# Optional: where to store the SQLite database
DB_PATH=meetup.db
